PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task_tracker
# Run pending migrations automatically on startup
DB_MIGRATIONS_RUN=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Short-lived access token; the frontend transparently exchanges a refresh token for a new
# pair when this expires (see JWT_REFRESH_EXPIRES_IN).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# "true" = anyone can sign up (gets the lowest access: no project memberships).
# "false" = only an admin can create accounts.
REGISTRATION_ENABLED=true
# "true" = any authenticated user can create a Team-managed project (and becomes its PM).
# "false" = only an admin can create projects (Company-managed only).
TEAM_PROJECTS_ENABLED=true

# Bootstrap admin (created on startup only if no admin exists yet)
ADMIN_EMAIL=admin@tracker.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=System Admin
